# Optional persistent no-database visitor counter.
# Put real credentials in Streamlit Secrets, not in this file.
GITHUB_COUNTER_TOKEN=
GITHUB_COUNTER_REPO=qxiao2ub/AI_WhatsApp_Scheme_Advisor
GITHUB_COUNTER_PATH=data/visitor_count.json
GITHUB_COUNTER_BRANCH=main
