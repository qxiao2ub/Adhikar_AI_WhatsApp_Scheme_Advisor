APP_AUTHOR=Praneel Bembey
APP_MENTOR=Dr. Qingyang Xiao
APP_NAME=Adhikaar.ai
APP_PUBLIC_URL=https://your-app-name.streamlit.app

# Durable backend. Blank = local SQLite demo.
DATABASE_URL=
DATA_RETENTION_DAYS=365

# Admin authentication. Prefer ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
HUMAN_ASSISTANCE_URL=

# Optional approved language-service adapter
BHASHINI_TRANSLATE_URL=
BHASHINI_API_KEY=

# WhatsApp Cloud API webhook deployment only
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional persistent non-identifying visitor counter.
GITHUB_COUNTER_TOKEN=
GITHUB_COUNTER_REPO=qxiao2ub/AI_WhatsApp_Scheme_Advisor
GITHUB_COUNTER_PATH=data/visitor_count.json
GITHUB_COUNTER_BRANCH=main
