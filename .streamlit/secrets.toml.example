# -----------------------------------------------------------------------------
# Durable backend (recommended for production)
# -----------------------------------------------------------------------------
# Leave blank for the zero-config SQLite demo backend.
# For Streamlit Cloud production, use a managed PostgreSQL connection string.
# Example format only; do NOT commit a real credential:
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DATABASE_URL = ""
DATA_RETENTION_DAYS = "365"

# Admin panel. Prefer the SHA-256 hash of a strong password.
# Generate locally, for example:
# python -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
ADMIN_PASSWORD_HASH = ""
# ADMIN_PASSWORD = ""  # supported only as a convenience fallback

# Optional external human-assistance destination.
